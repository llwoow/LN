    {
      "id": "magnetization",
      "title": "磁化强度 M",
      "symbolHtml": "<span>磁化强度 M</span>",
      "keys": [
        "bold:M",
        "bold:M_mag",
        "M_mag"
      ],
      "description": "磁化强度，须与互感 M 区分。",
      "unitHtml": "A/m",
      "section": "magnetic-sec11",
      "match": "为磁化强度"
    }
  ]
}
