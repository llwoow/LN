  "core_topics": {
    "opamp_bandwidth_characteristics": {
      "description": "运算放大器带宽特性",
      "basic_definitions": {
        "3dB_bandwidth": "f_{-3dB} = f_T / A_CL",
        "open_loop_gain": "A_OL(f) = A_DC / (1 + jf/f_P)",
        "single_pole_model": "A_OL(s) = A_DC / (1 + s/ω_P)"
      },
      "frequency_response": {
        "low_frequency": "平坦段，增益 = 20log(A_DC)",
        "cutoff_frequency": "-20dB/dec滚降",
        "high_frequency": "-20dB/dec渐近线"
      },
      "multi_pole_models": {
        "second_order": "A_OL(s) = A_DC / [(1 + s/ω_P1)(1 + s/ω_P2)]",
        "third_order": "A_OL(s) = A_DC / [(1 + s/ω_P1)(1 + s/ω_P2)(1 + s/ω_P3)]"
      },
      "practical_characteristics": [
        "主极点：决定低频滚降特性",
        "次极点：影响相位裕度和稳定性",
        "高频极点：影响噪声性能",
        "零点：可能改善相位响应"
      ]
    },
    "gain_bandwidth_product": {
      "description": "增益带宽积(GBW)",
      "basic_concept": "GBW = A_CL × f_{-3dB} = 常数",
      "physical_meaning": [
        "运放的基本性能指标",
        "与工艺和设计相关",
        "在一定频率范围内保持恒定"
      ],
      "theoretical_analysis": {
        "single_pole_opamp": "GBW = A_DC × f_P",
        "closed_loop_bandwidth": "f_{-3dB} = GBW / A_CL",
        "gain_bandwidth_relationship": "20log|A_CL| + 20log|f_{-3dB}| = 20log|GBW|"
      },
      "design_considerations": [
        "精度要求：更高的精度需要更低的闭环增益",
        "带宽需求：应用带宽决定了所需的GBW",
        "功耗权衡：高GBW通常伴随更高的功耗",
        "噪声性能：GBW与噪声特性相关"
      ],
      "application_examples": [
        {
          "application": "音频放大",
          "bandwidth": "20kHz",
          "gain": "10",
          "required_gbw": "200kHz"
        },
