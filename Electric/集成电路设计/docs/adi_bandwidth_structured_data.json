          "required_gbw": "100MHz"
        },
        {
          "application": "RF应用",
          "bandwidth": "100MHz",
          "gain": "1",
          "required_gbw": "100MHz"
        },
        {
          "application": "视频放大",
          "bandwidth": "10MHz",
          "gain": "2",
          "required_gbw": "20MHz"
        }
      ],
      "limitations": [
        "GBW在高频时可能下降",
        "工艺变化影响GBW稳定性",
        "温度对GBW有显著影响",
        "大信号条件下的GBW压缩"
      ]
    },
    "frequency_response_analysis": {
      "description": "频率响应分析",
      "bode_plot_analysis": {
        "magnitude_response": "|A(jω)| = |A_DC| / √(1 + (ω/ω_P)²)",
        "phase_response": "∠A(jω) = -arctan(ω/ω_P)",
        "bode_approximation": [
          "频率 < ω_P: 0dB/dec, 0°相位",
          "频率 = ω_P: -3dB, -45°相位",
          "频率 >> ω_P: -20dB/dec, -90°相位"
        ]
      },
      "closed_loop_response": {
        "basic_formula": "A_CL(jω) = A_OL(jω) / [1 + β × A_OL(jω)]",
        "low_frequency": "A_CL ≈ 1/β (A_OL >> 1/β)",
        "high_frequency": "A_CL ≈ A_OL (A_OL << 1/β)",
        "cutoff_frequency": "|A_CL(jω_C)| = |1/β| / √2"
      },
      "phase_margin_analysis": {
        "definition": "PM = 180° + ∠A_OL(jω_GC)",
        "stability_criteria": [
          "PM > 45°: 良好稳定性",
          "PM > 60°: 优秀稳定性",
          "PM < 30°: 可能不稳定"
        ],
        "calculation": "PM = 180° - ∑arctan(ω_GC/ω_Pi)"
      },
      "gain_margin_analysis": {
        "definition": "GM = -20log|A_OL(jω_PC)|",
        "stability_criteria": [
          "GM > 10dB: 良好稳定性",
          "GM > 20dB: 优秀稳定性"
        ]
      }
    },
    "bandwidth_flatness": {
