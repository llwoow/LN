{
  "title": "差分放大器设计技术数据",
  "version": "1.0",
  "date": "2025-11-02",
  "basic_principles": {
    "circuit_structure": {
      "description": "对称的双晶体管对（BJT/MOSFET）+ 恒流源 + 负载电阻的经典拓扑",
      "components": [
        "对称双晶体管对",
        "恒流源偏置",
        "负载电阻",
        "差分输出"
      ]
    },
    "signal_definition": {
      "differential_mode": {
        "definition": "Vid = Vin1 - Vin2",
        "characteristics": "两个输入端信号大小相等，相位相反",
        "purpose": "差分放大器的主要放大对象"
      },
      "common_mode": {
        "definition": "Vic = (Vin1 + Vin2) / 2",
        "characteristics": "两个输入端信号大小相等，相位相同",
        "purpose": "需要被抑制的共模干扰"
      },
      "output_signals": {
        "differential_output": "Vod = Vout1 - Vout2",
        "common_output": "Voc = (Vout1 + Vout2) / 2"
      }
    }
  },
  "mathematical_analysis": {
    "differential_gain": {
      "formula": "Ad = Vod / Vid ≈ -gm × Rc",
      "variables": {
        "Ad": "差模增益",
        "gm": "晶体管跨导",
        "Rc": "集电极电阻"
      },
      "derivation": "差模信号作用下，两个晶体管电流变化相反，总电流保持恒定，输出电压变化为ΔVout = -gm × Vid × Rc"
    },
    "common_mode_gain": {
      "formula": "Ac = Voc / Vic ≈ -Rc / (2 × ro)",
      "variables": {
        "Ac": "共模增益",
        "ro": "晶体管输出电阻"
      },
      "derivation": "共模信号作用下，两个晶体管电流变化相同，恒流源抑制电流变化，输出电压变化主要由晶体管输出电阻决定"
    },
    "cmrr": {
      "formula": "CMRR = |Ad| / |Ac|",
      "ideal_case": "Ad → ∞, Ac → 0, CMRR → ∞",
      "practical_calculation": "CMRR = gm × ro"
    }
  },
  "performance_specifications": {
    "differential_mode_performance": {
      "differential_gain": {
        "definition": "放大差模信号的能力",
        "calculation": "Ad = -gm × Rc",
        "design_requirement": "根据应用需求确定合适的增益"
      },
      "input_impedance": {
        "bjt_formula": "Rid ≈ 2 × β × rπ",
        "mosfet_formula": "Rid ≈ 2 / gm",
        "requirement": "高输入阻抗以减少信号源负载"
      },
      "bandwidth": {
        "definition": "差模增益下降3dB的频率",
        "factors": ["晶体管fT", "负载电容", "Miller效应"]
      }
    },
    "common_mode_performance": {
      "common_mode_gain": {
        "definition": "对共模信号的放大倍数",
        "ideal_value": "Ac ≈ 0",
        "practical_value": "Ac = -Rc/(2 × ro)"
      },
      "cmrr": {
        "definition": "CMRR = |Ad|/|Ac|",
        "ideal_value": "∞",
        "practical_requirement": ">80dB（精密应用）"
      }
    },
    "other_indicators": {
      "psrr": {
        "definition": "输出对电源噪声的抑制能力",
        "calculation": "PSRR = Ad / A_ps",
        "requirement": ">60dB"
      },
      "offset_voltage": {
        "definition": "零输入时的输出电压",
        "sources": ["晶体管参数失配", "电阻失配"],
        "requirement": "<1mV（精密应用）"
      },
      "offset_current": {
        "definition": "零输入时的基极/栅极电流差",
        "sources": "晶体管β失配",
        "requirement": "<1nA"
      }
    }
  },
