{
  "title": "Miller频率补偿技术数据",
  "version": "1.0",
  "date": "2025-11-02",
  "basic_principles": {
    "miller_effect": {
      "description": "跨接在输入和输出之间的电容在输入端产生的等效电容增加现象",
      "formula": "C_Miller = C_m × (1 - A_v)",
      "variables": {
        "C_Miller": "Miller等效电容",
        "C_m": "实际补偿电容",
        "A_v": "中间级电压增益（通常为负值）"
      }
    },
    "pole_splitting": {
      "description": "Miller补偿导致极点分离，主极点降低，次极点提高",
      "main_pole": "ω₁ = 1/(R₁ × C_Miller)",
      "secondary_pole": "ω₂ = g_m₂/(C_L + C_m)",
      "separation_condition": "ω₂/ω₁ ≥ 10"
    }
  },
  "mathematical_models": {
    "transfer_function": {
      "basic_form": "A(s) = A₀ / [(1 + s/ω₁)(1 + s/ω₂)]",
      "variables": {
        "A₀": "直流增益",
        "ω₁": "主极点频率",
        "ω₂": "次极点频率"
      }
    },
    "zero_analysis": {
      "right_half_plane_zero": "ω_z = g_m₁ / C_m",
      "elimination_method": "R_z = 1/g_m₁",
      "purpose": "改善相位响应"
    }
  },
  "design_formulas": {
    "compensation_capacitor": {
      "basic_calculation": "C_m = (2π × f_c × C_L) / g_m₂",
      "precision_formula": "C_m ≥ 10 × C_L / β_min",
      "variables": {
        "f_c": "目标交叉频率",
        "C_L": "负载电容",
        "g_m₂": "输出级跨导",
        "β_min": "最小反馈系数"
      }
    },
    "pole_frequencies": {
      "main_pole": "ω₁ = 1/(R₁ × C_m × |A_v|)",
      "secondary_pole": "ω₂ = g_m₂/(C_L + C_m)"
    }
  },
