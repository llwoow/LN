    "analysis_date": "2025-11-02",
    "status": "基于经典运放理论框架生成（网络连接限制）"
  },
  "core_topics": {
    "ideal_opamp_model": {
      "description": "运算放大器理想模型",
      "key_assumptions": [
        "无限开环增益 A_ol → ∞",
        "无限输入阻抗 R_in → ∞",
        "零输出阻抗 R_out → 0",
        "零输入偏置电流 I_B = 0",
        "零输入失调电压 V_os = 0",
        "无限带宽 BW → ∞",
        "零噪声特性"
      ],
      "fundamental_equations": [
        "V_out = A_ol × (V+ - V-)",
        "V+ ≈ V- (虚短条件)",
        "I+ = I- = 0 (虚断条件)"
      ]
    },
    "transfer_function_derivation": {
      "description": "传递函数推导方法",
      "inverting_amplifier": {
        "circuit_description": "反相放大器，输入电阻R₁，反馈电阻R_f",
        "derivation_steps": [
          "应用KCL: (V_in - V-)/R₁ + (V_out - V-)/R_f = 0",
          "虚短条件: V- ≈ V+ = 0",
          "求解: V_in/R₁ + V_out/R_f = 0",
          "传递函数: V_out/V_in = -R_f/R₁"
        ],
        "closed_loop_gain": "A_cl = -R_f/R₁"
      },
      "noninverting_amplifier": {
        "circuit_description": "非反相放大器，电阻分压器反馈",
        "derivation_steps": [
          "电压分压: V- = V_out × R₁/(R₁ + R_f)",
          "虚短条件: V+ = V- = V_in",
          "求解: V_in = V_out × R₁/(R₁ + R_f)",
          "传递函数: V_out/V_in = (R₁ + R_f)/R₁"
        ],
        "closed_loop_gain": "A_cl = 1 + R_f/R₁"
      },
      "differential_amplifier": {
        "circuit_description": "差分放大器",
        "transfer_function": "V_out = (R_f/R₁) × (V₂ - V₁)",
        "when_balanced": "V_out = (R_g/R) × (V₂ - V₁)"
      }
    },
    "feedback_system_analysis": {
      "description": "反馈系统分析",
      "basic_structure": {
        "forward_path": "A (开环增益)",
        "feedback_path": "β (反馈传递函数)",
        "closed_loop": "A_cl = A/(1 + Aβ)"
      },
      "special_cases": [
        "高增益情况 (A → ∞): A_cl → 1/β",
        "低反馈情况 (Aβ >> 1): A_cl ≈ 1/β",
        "高反馈情况 (Aβ << 1): A_cl ≈ A"
      ],
      "performance_improvements": [
        "增益稳定性：闭环增益主要由反馈网络决定",
        "带宽扩展：闭环带宽 = 开环带宽 × (1 + Aβ)",
        "阻抗调节：输入阻抗增加，输出阻抗降低",
        "噪声抑制：减少非线性失真，提高信噪比"
      ]
    },
    "frequency_response": {
      "description": "频率响应特性",
      "open_loop_response": {
        "single_pole_model": "A_ol(s) = A_dc/(1 + s/ω_p)",
        "gain_bandwidth_product": "GBW = A_dc × f_p",
        "bode_plot_characteristics": [
          "低频：平坦段，增益 = 20log(A_dc)",
          "截止频率：-20dB/dec滚降",
          "高频：-20dB/dec渐近线"
        ]
      },
      "closed_loop_response": {
        "first_order_lowpass": "A_cl(jω) = A_cl_dc/√(1 + (ω/ω_cl)²)",
        "closed_loop_bandwidth": "f_cl = GBW/A_cl_dc"
      },
      "stability_analysis": {
        "phase_margin": "PM = 180° + ∠A(jω_gc)",
        "gain_margin": "GM = -20log|A(jω_pc)|",
        "stability_criteria": [
          "相位裕度 > 45°",
          "增益裕度 > 10dB"
        ]
      }
    }
  },
  "key_mathematical_formulas": {
    "basic_relationships": [
      "V_out = A_ol × (V+ - V-)",
      "V+ = V- (虚短条件)",
      "I+ = I- = 0 (虚断条件)"
    ],
    "transfer_functions": [
      "A_cl = -R_f/R₁ (反相放大器)",
      "A_cl = 1 + R_f/R₁ (非反相放大器)",
      "A_cl = R_f/R₁ (差分放大器)"
    ],
    "feedback_systems": [
      "A_cl = A/(1 + Aβ)",
      "1/A_cl = β + 1/A"
    ],
    "frequency_response": [
      "A_ol(s) = A_dc/(1 + s/ω_p)",
      "f_cl = GBW/A_cl_dc",
      "PM = 180° + ∠A(jω_gc)"
    ]
  },
